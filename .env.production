# Committed on purpose. NEXT_PUBLIC_* is inlined into the browser bundle at
# build time, so this URL is public either way — keeping it here means a
# production build points at the live API without depending on the Vercel
# dashboard being configured. A dashboard variable of the same name still
# wins, so overriding per-environment stays possible.
NEXT_PUBLIC_API_URL=https://pickleball-backend-mwc3.onrender.com/api
